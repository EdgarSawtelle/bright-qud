<?xml version="1.0" encoding="utf-8"?>
<commands>
  <command ID="CmdBrightQudControls" DisplayText="Bright Qud: controls reminder" Category="Adventuring" Layer="Adventure" Auto="Down">
    <keyboardBind Key="F3"/>
    <gamepadBind Alt="true" Button="select"/>
  </command>
  <command ID="CmdBrightQudQuests" DisplayText="Bright Qud: quests (nearest first, pick one to follow)" Category="Adventuring" Layer="Adventure" Auto="Down">
    <keyboardBind Key="F4"/>
    <gamepadBind Alt="true" Button="leftStickPress"/>
  </command>
  <command ID="CmdBrightQudMarkers" DisplayText="Bright Qud: item sparkle and gold corners on/off" Category="Adventuring" Layer="Adventure" Auto="Down">
    <keyboardBind Key="F6"/>
  </command>
</commands>
